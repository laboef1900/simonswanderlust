    "upload": "tsx src/cli.ts",
    "copy:fonts": "node scripts/copy-fonts.mjs",
    "copy:easymde": "node scripts/copy-easymde.mjs",
    "copy:vendor": "node scripts/copy-vendor.mjs",
    "build:native": "node scripts/build-native.mjs",
    "copy:legal": "node scripts/copy-legal.mjs uploader",
    "test": "vitest run",
    "pretest:e2e": "npm run copy:vendor && npm run copy:fonts && npm run copy:legal && node scripts/copy-legal.mjs site",
