    "easymde": "^2.21.0",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.9.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "tar": "^7.5.19",
    "tsx": "^4.23.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/turndown": "^5.0.6",
    "form-data": "^4.0.6",
    "typescript": "^6.0.3",
