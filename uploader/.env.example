# Copy to .env at the REPO ROOT (next to docker-compose.yml).
#
# ── Docker deployment (docker compose up -d) ────────────────────────────────

# Postgres (the db container). Set a strong password. The compose file derives
# the app's DATABASE_URL from these three automatically — no need to repeat
# the password anywhere else.
POSTGRES_USER=images
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=images

# Optional encrypted AI review credentials. Leave UNSET for local-only use;
# an explicitly empty or malformed value refuses boot. Generate privately:
#   openssl rand -hex 32
# Store the 64 hex characters as ENCRYPTION_KEY in your private .env and
# recreate the app container after changes. Never paste the key into logs/issues.
# Escrow it separately from DB dumps: encrypted backups need the original key.
# ENCRYPTION_KEY=<64 hexadecimal characters from your private generator>

# Required: the public URL of your IMAGE domain (not the blog domain, which is set
# in Settings → Site identity) and its host. Compose refuses to start without both.
# Left empty on purpose, like IMAGE_TAG: fill in your own values, for example
#   PUBLIC_BASE_URL=https://img.example.com   and   IMG_HOST=img.example.com
# For a local trial use PUBLIC_BASE_URL=http://localhost:3000 and IMG_HOST=localhost:3000.
PUBLIC_BASE_URL=
IMG_HOST=

# Required: a version published to ghcr.io/laboef1900/wanderlust-studio (0.18.1 or
# later; see the GitHub releases). There is no default. Do not reuse 0.17.1 or older
# here: those releases belong to simonswanderlust-app and do not resolve under this name.
# For an image built from the current source use IMAGE_TAG=local (README.md).
IMAGE_TAG=

# ── Bare local dev only (npm run dev in uploader/, no Docker) ───────────────
# The path/port vars below are ignored by the container (the image bakes its
# own); set them only when running the app directly on your machine.
#
# @ai-warning: DATABASE_URL is the exception — docker compose DOES pick it up
# as an override of the derived db:5432 URL. Keep it commented while using
# Docker, or the container will try to reach your host's 127.0.0.1 Postgres.
# DATABASE_URL=postgres://images:change-me-to-a-long-random-string@127.0.0.1:5432/images
# STORAGE_DIR=./data/images   # image originals + variants; settings.json and
#                             # backup/ default to siblings of this directory
# SETTINGS_PATH=./data/settings.json
# BACKUP_DIR=./data/backup    # MDX exports + (in db/) database dumps
# MAP_DIR=./map-assets        # PMTiles basemap + glyph fonts served at /map/
# PORT=3000
# SITE_APP_DIR=../site        # Astro project, for local rebuild testing
# SITE_DIR=./data/site        # where releases + the current symlink land
