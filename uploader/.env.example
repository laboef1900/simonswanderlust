# Copy to .env at the REPO ROOT (next to docker-compose.yml).
#
# ── Docker deployment (docker compose up -d) ────────────────────────────────

# Postgres (the db container). Set a strong password. The compose file derives
# the app's DATABASE_URL from these three automatically — no need to repeat
# the password anywhere else.
POSTGRES_USER=images
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=images

# Public base URL where images are served (your img. subdomain).
PUBLIC_BASE_URL=https://img.simonswanderlust.com

# Host header that serves image variants (hostname of PUBLIC_BASE_URL).
# For local dev where variants load from localhost, set IMG_HOST=localhost:3000.
IMG_HOST=img.simonswanderlust.com

# Released image version to run from GHCR (docker compose pull && up -d).
# Bump this on each release; omit to fall back to the compose default.
IMAGE_TAG=0.5.0

# ── Bare local dev only (npm run dev in uploader/, no Docker) ───────────────
# The path/port vars below are ignored by the container (the image bakes its
# own); set them only when running the app directly on your machine.
#
# @ai-warning: DATABASE_URL is the exception — docker compose DOES pick it up
# as an override of the derived db:5432 URL. Keep it commented while using
# Docker, or the container will try to reach your host's 127.0.0.1 Postgres.
# DATABASE_URL=postgres://images:change-me-to-a-long-random-string@127.0.0.1:5432/images
# STORAGE_DIR=./data/images
# PORT=3000
# SITE_APP_DIR=../site        # Astro project, for local rebuild testing
# SITE_DIR=./data/site        # where releases + the current symlink land
