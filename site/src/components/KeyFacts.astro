---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  facts: Record<string, string>;
  country: string;
  locale: Locale;
}

const { facts, country, locale } = Astro.props;
const t = useTranslations(locale);
---

<details class="mb-6 border-b border-navy/15 bg-canvas">
  <summary class="min-h-[44px] cursor-pointer py-3 text-sm font-semibold text-navy marker:text-brand-red hover:text-brand-red focus-visible:outline-2 focus-visible:outline-brand-red focus-visible:outline-offset-2 [overflow-wrap:anywhere]">
    {t('story.keyFactsAbout')} {country}
  </summary>
  <dl class="grid gap-x-8 gap-y-4 pt-2 pb-5 text-sm leading-6 sm:grid-cols-2">
    {
      Object.entries(facts).map(([key, value]) => (
        <div class="min-w-0 [overflow-wrap:anywhere]">
          <dt class="font-mono text-xs font-semibold tracking-wider text-navy uppercase">{key}</dt>
          <dd class="mt-1 text-ink">{value}</dd>
        </div>
      ))
    }
  </dl>
</details>
