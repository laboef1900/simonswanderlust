---
import { useTranslations, type Locale } from '../i18n/ui';
import { homePath } from '../lib/paths';
import LangSwitcher from './LangSwitcher.astro';
import { identity, identitySiteName } from '../lib/build-identity';
import type { ResolvedNavItem } from '../lib/resolve-navigation';

interface Props {
  locale: Locale;
  alternates?: { de: string; en: string };
  items: ResolvedNavItem[];
}

const { locale, alternates, items } = Astro.props;
const t = useTranslations(locale);

// @ai-warning Two rules keep this header inside a phone viewport, and both are
// load-bearing:
//   (i) the nav wraps to its own line below `sm`. The German labels
//       ("Reiseberichte" / "Karte" / "Über mich") are ~40px wider than the
//       English ones, so the single-row header measured scrollWidth 415 against
//       a 390px viewport — the whole page scrolled sideways and the language
//       switcher sat entirely off-screen, in the DEFAULT locale.
//   (ii) targets are padded 44px boxes, not 20px glyph boxes. Nine controls on
//       the home page were under 24×24 (WCAG 2.2 SC 2.5.8), and the 20px `gap`
//       was too small to earn the spacing exception.
// Re-measure `scrollWidth === clientWidth` at 320/360/375/390 in BOTH locales
// after touching this file; `flex-wrap` on the nav is what makes 320 survive.
// Mobile has no vertical shell padding: its two 44px target rows are the
// irreducible height without overlapping controls.
const link = 'inline-flex min-h-[44px] max-w-full items-center rounded px-2 transition-[color] [overflow-wrap:anywhere]';
const active = 'font-semibold text-brand-red';
const idle = 'text-ink/80 hover:text-brand-red active:text-brand-red';
---

<header class="border-b border-navy/10 bg-canvas">
  <div
    class="mx-auto flex max-w-6xl flex-col px-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-2"
  >
    <a
      href={homePath(locale)}
      class={`${link} -ml-2 min-w-0 max-w-full self-start text-sm font-extrabold tracking-wide text-navy uppercase hover:text-brand-red sm:self-auto`}
    >
      {identity.assets.logo ? (
        <img
          src={identity.assets.logo.path}
          width={identity.assets.logo.width}
          height={identity.assets.logo.height}
          alt={identitySiteName(locale)}
          class="h-8 w-auto min-w-0 max-w-full object-contain object-left"
        />
      ) : (
        <span class="min-w-0 [overflow-wrap:anywhere]">{identitySiteName(locale)}</span>
      )}
    </a>
    <nav
      aria-label={t('nav.ariaLabel')}
      class="-mx-2 flex min-w-0 flex-wrap items-center gap-x-1 text-sm font-medium sm:mx-0 sm:justify-end"
    >
      {items.map((item) => <a
        href={item.href}
        aria-current={item.current ? 'page' : undefined}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener noreferrer' : undefined}
        class:list={[link, item.current ? active : idle]}
      >
        <span>{item.label}{item.external && <> ↗<span class="sr-only"> {t('nav.newTab')}</span></>}</span>
      </a>)}
      <LangSwitcher locale={locale} alternates={alternates} />
    </nav>
  </div>
</header>
