---
import { useTranslations, type Locale } from '../i18n/ui';
import { aboutPath, homePath, mapPath } from '../lib/paths';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale: Locale;
  alternates?: { de: string; en: string };
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;

const isHome = pathname === homePath(locale) || pathname === homePath(locale) + '/';
const isMap = pathname.startsWith(mapPath(locale));
const isAbout = pathname.startsWith(aboutPath(locale));

// @ai-warning Two rules keep this header inside a phone viewport, and both are
// load-bearing:
//   (i) the nav wraps to its own line below `sm`. The German labels
//       ("Reiseberichte" / "Karte" / "Über mich") are ~40px wider than the
//       English ones, so the single-row header measured scrollWidth 415 against
//       a 390px viewport — the whole page scrolled sideways and the language
//       switcher sat entirely off-screen, in the DEFAULT locale.
//   (ii) targets are padded 44px boxes, not 20px glyph boxes. Nine controls on
//       the home page were under 24×24 (WCAG 2.2 SC 2.5.8), and the 20px `gap`
//       was too small to earn the spacing exception.
// Re-measure `scrollWidth === clientWidth` at 320/360/375/390 in BOTH locales
// after touching this file; `flex-wrap` on the nav is what makes 320 survive.
const link = 'inline-flex min-h-[44px] items-center rounded px-2 transition-[color]';
const active = 'font-semibold text-brand-red';
const idle = 'text-ink/80 hover:text-brand-red';
---

<header class="border-b border-navy/10 bg-canvas">
  <div
    class="mx-auto flex max-w-6xl flex-col px-5 py-1 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-2"
  >
    <a
      href={homePath(locale)}
      class={`${link} -ml-2 self-start text-sm font-extrabold tracking-wide text-navy uppercase hover:text-brand-red sm:self-auto`}
    >
      {t('site.title')}
    </a>
    <nav
      aria-label={t('nav.ariaLabel')}
      class="-mx-2 flex flex-wrap items-center gap-x-1 text-sm font-medium sm:mx-0 sm:justify-end"
    >
      <a
        href={homePath(locale) + '#stories'}
        aria-current={isHome ? 'page' : undefined}
        class:list={[link, isHome ? active : idle]}
      >
        {t('nav.stories')}
      </a>
      <a href={mapPath(locale)} aria-current={isMap ? 'page' : undefined} class:list={[link, isMap ? active : idle]}>
        {t('nav.map')}
      </a>
      <a
        href={aboutPath(locale)}
        aria-current={isAbout ? 'page' : undefined}
        class:list={[link, isAbout ? active : idle]}
      >
        {t('nav.about')}
      </a>
      <LangSwitcher locale={locale} alternates={alternates} />
    </nav>
  </div>
</header>
