---
import RemoteImage from './RemoteImage.astro';
import Stamp from './Stamp.astro';
import { useTranslations } from '../i18n/ui';
import { coordsLabel, dateLabel, entryLabel } from '../lib/format';
import { localeOf, pathOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Chronological entry number for the N° label. */
  number?: number;
}

const { trip, number } = Astro.props;
const locale = localeOf(trip);
const t = useTranslations(locale);
const label = [
  t('home.heroLabel'),
  [number !== undefined ? entryLabel(number) : null, `${dateLabel(trip.data.date, locale)} · ${trip.data.country}`]
    .filter(Boolean)
    .join(' '),
].join(' — ');
---

<section class="relative h-[55vh] sm:h-[65vh] min-h-[360px] sm:min-h-[420px]">
  <RemoteImage
    image={trip.data.heroImage}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-navy/95 via-navy/50 to-navy/20"></div>
  
  {/* Stamp Watermark Signature (Desktop/Tablet) */}
  <div class="pointer-events-none absolute top-6 right-6 z-10 hidden sm:block opacity-90 transition-opacity hover:opacity-100">
    <div class="rounded border border-white/20 bg-navy/60 p-2.5 backdrop-blur-xs shadow-lg">
      <Stamp
        countryCode={trip.data.countryCode}
        country={trip.data.country}
        date={trip.data.date}
        region={trip.data.region}
        locale={locale}
      />
    </div>
  </div>

  <div class="absolute right-0 bottom-0 left-0">
    <div class="mx-auto max-w-6xl px-5 pb-8 sm:pb-12 text-white">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded border border-white/25 bg-navy/60 px-2.5 py-0.5 font-mono text-[11px] font-semibold tracking-[0.15em] text-white/90 uppercase backdrop-blur-xs">
          {t('site.title')} — {t('site.tagline')}
        </span>
      </div>
      <p class="font-mono text-xs font-semibold tracking-[0.25em] text-brand-red-light uppercase">
        {label}
      </p>
      <h1 class="mt-2 max-w-3xl text-4xl font-extrabold md:text-5xl text-white drop-shadow-xs">{trip.data.title}</h1>
      <p class="mt-3 max-w-xl text-white/90">{trip.data.excerpt}</p>
      <p class="mt-2 font-mono text-xs tracking-[0.15em] text-white/70">
        {coordsLabel(trip.data.coordinates)}
      </p>
      <a
        href={pathOf(trip)}
        class="group/btn mt-5 inline-flex items-center gap-2 rounded bg-brand-red px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-brand-red-light hover:shadow-lg"
      >
        <span>{t('home.readStory')}</span>
        <svg aria-hidden="true" focusable="false" class="h-4 w-4 transition-transform duration-300 group-hover/btn:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
