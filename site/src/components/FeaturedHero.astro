---
import RemoteImage from './RemoteImage.astro';
import Stamp from './Stamp.astro';
import { useTranslations } from '../i18n/ui';
import { coordsLabel, dateLabel, entryLabel } from '../lib/format';
import { heroAltOf, localeOf, pathOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Chronological entry number for the N° label. */
  number?: number;
}

const { trip, number } = Astro.props;
const locale = localeOf(trip);
const t = useTranslations(locale);
const meta = `${dateLabel(trip.data.date, locale)} · ${trip.data.country}`;

/*
  @ai-note This component is the HOME PAGE's front door and nothing else, which
  is why it owns the document's <h1>. That <h1> is the site's tagline, not the
  featured trip's title: a homepage whose only <h1> is "Bukarest in 4 Tagen"
  tells every outline reader — and every first-time visitor — that the page is
  about Bucharest, and the same string was then repeated verbatim as the first
  card's <h3> two screens down. The entry below the rule is an <h2>, the same
  level as "Alle Reiseberichte", because that is what it is: one promoted item,
  not the subject of the page.
*/
const titleId = 'hero-entry-title';

// @ai-note The stored hero alt is the post title on every WordPress-imported
// post, and the entry heading below announces that title anyway — so a screen
// reader heard it twice. Decorative ONLY in that case: a hand-written alt that
// actually describes the photograph still reaches the image. Shared with
// StoryCard, which shows the same photo beside the same title.
const heroAlt = heroAltOf(trip);

// Mobile shows the full frame at its natural aspect, above the entry panel.
// Desktop still crops into a fixed-height cover: hint the painted width,
// max(box width, cover height × 1.5), rather than under-fetching tall crops.
const HERO_SIZES = '(max-width: 639px) 100vw, max(100vw, min(120vh, 1080px), 720px)';
---

<section class="relative bg-canvas sm:h-[80vh] sm:max-h-[720px] sm:min-h-[480px]">
  <div class="relative sm:absolute sm:inset-0">
    <RemoteImage
      image={trip.data.heroImage}
      alt={heroAlt}
      sizes={HERO_SIZES}
      loading="eager"
      fetchpriority="high"
      class="block h-auto w-full object-cover sm:h-full"
    />
    {/*
    A grounding vignette, not a scrim. Nothing on this hero reads against the
    photograph any more — the entry sits on opaque paper and the stamp on its
    own opaque chip — so the gradient no longer has a contrast job at all. What
    is left is the job it should always have had: seating the paper on the
    frame and closing the bottom crop. Alpha above this is photograph thrown
    away on a page whose premise is the photograph.
  */}
    <div class="absolute inset-0 hidden bg-gradient-to-t from-navy/45 via-navy/10 via-40% to-transparent sm:block"></div>

    {/*
    @ai-warning The stamp's inks are DARK (`lib/stamp.ts`: near-black, navy,
    oxblood, plum, forest) and it blends `multiply` — a rubber stamp pressed
    onto paper. It used to sit on a `bg-navy/60` backdrop-blur plate, i.e.
    dark ink multiplied into a dark translucent panel, and measured 1.28:1 to
    2.58:1 against the sky behind it: the single most ownable mark on the site
    rendered as an illegible smudge, and was then hidden below `sm` so most
    visitors never saw it at all. It now sits on an OPAQUE canvas chip — the
    passport page the ink belongs on — where the lightest ink (#c0311e)
    measures 5.49:1 and the darkest 16.5:1, on every photograph. Never tint
    this chip or make it translucent.

    The chip stays square while the ink inside it is rotated by
    `stampStyle()`, so the stamp reads as pressed askew onto straight paper
    rather than as a tilted widget. Shown at every width now that it is
    legible: 124px + margins clears a 320px viewport.
  */}
    <div class="pointer-events-none absolute top-4 right-4 z-10 origin-top-right scale-90 sm:top-6 sm:right-6 sm:scale-100">
      <div class="rounded-sm bg-canvas p-2 shadow-lg sm:p-2.5">
        <Stamp
          countryCode={trip.data.countryCode}
          country={trip.data.country}
          date={trip.data.date}
          region={trip.data.region}
          locale={locale}
        />
      </div>
    </div>
  </div>

  <div class="relative sm:absolute sm:right-0 sm:bottom-0 sm:left-0">
    <div class="mx-auto max-w-6xl px-5 py-6 sm:pt-0 sm:pb-10">
      {/*
        @ai-warning This panel is OPAQUE paper — the same material as the stamp
        chip above it, and for the same reason. Every previous version of this
        hero set white type straight onto the gradient and then spent the rest
        of its life defending that decision: the log line measured 1.19:1 on a
        phone before it got its own navy plate, and the headline still sat at
        ~2.8:1 whenever a long German compound pushed its top line up out of the
        dark end of the scrim. Type on paper is 5.4:1 to 14:1 on every frame,
        at any length, with no scrim at all — which is also what let the
        gradient above drop to a vignette. Never tint this panel with an alpha,
        and never move type back onto the photograph.
      */}
      <div class="max-w-2xl bg-canvas sm:rounded-sm sm:p-6 sm:shadow-2xl">
        {/*
          Set quietly on purpose. The wordmark is in the header ~60px above
          this line, so repeating the identity at display size would be the
          page shouting its own name; what was actually missing was any
          statement of what the site IS in the first viewport at all — the
          tagline rendered only in the footer, three screens down.
        */}
        <h1 class="text-base font-semibold tracking-[-0.01em] text-navy/75 sm:text-lg">
          {t('site.tagline')}
        </h1>
        {/*
          The route motif, earned rather than decorative: it separates the
          masthead from the entry, which is the one place on this page where a
          dashed rule is dividing two different kinds of thing. RouteDivider
          draws the same line between the index and the map band.
        */}
        <div aria-hidden="true" class="mt-4 border-t border-dashed border-navy/25"></div>
        {/*
          One link, not two. The whole entry is the target — a 44px text link
          under a headline the visitor already read is a second chance to miss —
          but `aria-labelledby` keeps the accessible name to the title alone,
          so a screen-reader user is not read the entry number, the date, the
          country, the coordinates and the excerpt before learning what the
          story is.
        */}
        <a
          href={pathOf(trip)}
          aria-labelledby={titleId}
          class="group/entry mt-4 block rounded-sm focus-visible:outline-brand-red"
        >
          <p class="flex flex-wrap items-center gap-x-2 font-mono text-[11px] font-semibold tracking-log uppercase">
            {number !== undefined && <span class="text-brand-red">{entryLabel(number)}</span>}
            <span class="text-navy/70">{meta}</span>
          </p>
          {/*
            @ai-warning `break-words` is not cosmetic. A 30-character German
            compound at this weight overflows a 390px viewport as one
            unbreakable word: measured `scrollingElement.scrollWidth` 819
            against `clientWidth` 390, i.e. 429px of sideways pan on the
            LANDING page in the default locale. `hyphens-auto` is the graceful
            version of that guard and is scoped to where it is needed —
            Base.astro sets `<html lang={locale}>`, so on a DE page it breaks
            at syllables — but from `sm` up the panel is wide enough that all
            it did was hyphenate the largest type on the site mid-word
            ("Bukarest in 4 Tagen: Nacht-/zug"). Above `sm`, `break-words`
            alone still catches a genuine overflow, just without the hyphen.
            The mobile entry stays in document flow, so longer titles grow the
            panel without colliding with the photograph or the story index.
          */}
          <h2
            id={titleId}
            class="mt-1.5 text-2xl leading-[1.12] font-extrabold text-balance break-words hyphens-auto text-navy transition-[color] group-hover/entry:text-brand-red sm:text-3xl sm:hyphens-none md:text-4xl"
          >
            {trip.data.title}
          </h2>
          <p class="mt-2 font-mono text-[11px] tracking-log text-navy/70">
            {coordsLabel(trip.data.coordinates)}
          </p>
          {/*
            Shown at every width now. It was `hidden sm:block` because on the
            old hero it was white-on-photograph and cost 158 characters of
            scrim; on paper it costs nothing, and it is the only thing on a
            phone that says what the story is ABOUT rather than where it was.
          */}
          <p class="mt-3 line-clamp-2 text-sm text-ink/80">{trip.data.excerpt}</p>
          <span class="mt-4 inline-flex min-h-[44px] items-center gap-2 text-sm font-semibold text-brand-red">
            <span>{t('home.readStory')}</span>
            <svg
              aria-hidden="true"
              focusable="false"
              class="h-4 w-4 transition-transform duration-300 motion-safe:group-hover/entry:translate-x-1"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
