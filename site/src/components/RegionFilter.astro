---
import { getCollection } from 'astro:content';
import { useTranslations, type Locale, type UIKey } from '../i18n/ui';
import { homePath, regionPath, regions, type Region } from '../lib/paths';
import { byLocale, regionCounts } from '../lib/trips';

interface Props {
  locale: Locale;
  active?: Region;
}

const { locale, active } = Astro.props;
const t = useTranslations(locale);

/*
  @ai-warning These are NAVIGATION. They used to be `rounded-full` pills with a
  filled active state, sitting in the same baseline row as the "Alle
  Reiseberichte" heading under the label "Nach Region filtern" — which is the
  universal grammar of an in-page filter, and every part of it was a lie. A
  visitor clicking "Europa 5" expected nine cards to become five; what happened
  was the document unloaded, the hero and the map went with it, and the only
  route back was another pill. That fired at the highest-intent moment on the
  page, the instant someone started narrowing toward a click.

  The control now says what it does: an index of destinations in the log
  register, each with the count of what it leads to and a trailing arrow, and
  no pill anywhere. If you ever want the other behaviour, filter the already
  rendered cards in place and keep `/reiseziele/*` as the crawlable href — the
  travel map is the precedent for that progressive enhancement. Do not go back
  to a control that looks like one and behaves like the other.

  The counts stay: a visitor used to jump blind from nine stories to two.
*/
const trips = byLocale(await getCollection('trips'), locale);
const counts = regionCounts(trips);

/*
  @ai-note "Alle" appears only on a region page. On the home page it was an
  `aria-current="true"` link to `/#stories` — announced as the current thing
  and still activatable, to nowhere, from a page already showing all nine
  stories directly below it. The escape hatch only exists where there is
  something to escape from, and it still means the full grid in every context
  (it used to point at the regions index from a region page, so the one way out
  led somewhere the visitor had never been).
*/
const allHref = homePath(locale) + '#stories';

const item =
  'group/dest inline-flex min-h-[44px] items-center gap-1.5 rounded font-mono text-[11px] font-semibold tracking-log uppercase underline-offset-4 transition-[color]';
const link = `${item} text-navy hover:text-brand-red hover:underline hover:decoration-dashed active:text-brand-red`;
/*
  @ai-note The current region is not a link to itself. It reads as the place
  you are — brand-red, no arrow, `aria-current` — which is the same decision as
  dropping "Alle" from the home page, one level in.
*/
const current = `${item} text-brand-red`;
// @ai-warning NO opacity utility on the count, and no alpha on the colour. It
// once carried `opacity-70` on top of an inherited `text-ink/70` and the two
// MULTIPLIED: `#16212e` landed at α 0.49 and measured 3.14:1 on canvas, a WCAG
// AA failure on the one glyph these links were given a count for. `brand-red`
// on canvas is 4.58:1 flat. `styles/tokens.test.ts` pins it.
const count = 'tabular-nums text-brand-red';
---

<nav aria-label={t('regions.navLabel')} class="flex flex-wrap items-center gap-x-5 gap-y-1">
  {
    active && (
      <a href={allHref} class={link}>
        <span>{t('home.filter.all')}</span>
        <span class={count}>{trips.length}</span>
        <svg
          aria-hidden="true"
          focusable="false"
          class="h-3 w-3 text-navy/55 transition-[color,transform] duration-300 group-hover/dest:text-brand-red motion-safe:group-hover/dest:translate-x-0.5"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    )
  }
  {
    regions.map((region) =>
      active === region ? (
        <span aria-current="true" class={current}>
          <span>{t(`region.${region}` as UIKey)}</span>
          <span class={count}>{counts[region]}</span>
        </span>
      ) : (
        <a href={regionPath(region, locale)} class={link}>
          <span>{t(`region.${region}` as UIKey)}</span>
          <span class={count}>{counts[region]}</span>
          <svg
            aria-hidden="true"
            focusable="false"
            class="h-3 w-3 text-navy/55 transition-[color,transform] duration-300 group-hover/dest:text-brand-red motion-safe:group-hover/dest:translate-x-0.5"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ),
    )
  }
</nav>
