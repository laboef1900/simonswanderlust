---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import KeyFacts from '../KeyFacts.astro';
import RouteDivider from '../RouteDivider.astro';
import StoryHero from '../StoryHero.astro';
import StoryPagination from '../StoryPagination.astro';
import Toc from '../Toc.astro';
import StoryMiniMap from '../StoryMiniMap.astro';
import GalleryIsland from '../GalleryIsland.astro';
import { byLocale, entryNumberOf, localeOf, pathOf, translationOf, type Trip } from '../../lib/trips';
import { PROD_SITE, blogPostingJsonLd, serializeJsonLd } from '../../lib/seo';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;
const locale = localeOf(trip);
const { Content, headings } = await render(trip);

const all = await getCollection('trips');
const number = entryNumberOf(trip, all);
const other = translationOf(trip, all);
const siblings = byLocale(all, locale);
const index = siblings.findIndex((s) => s.id === trip.id);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index < siblings.length - 1 ? siblings[index + 1] : undefined;

const alternates = other
  ? locale === 'de'
    ? { de: pathOf(trip), en: pathOf(other) }
    : { de: pathOf(other), en: pathOf(trip) }
  : undefined;

// Same production fallback as Base.astro's canonical URL.
const site = Astro.site ?? PROD_SITE;
const jsonLd = serializeJsonLd(
  blogPostingJsonLd({
    title: trip.data.title,
    date: trip.data.date,
    excerpt: trip.data.excerpt,
    locale,
    image: trip.data.heroImage,
    url: new URL(pathOf(trip), site).href,
  }),
);
---

<Base
  title={trip.data.title}
  description={trip.data.excerpt}
  locale={locale}
  alternates={alternates}
  image={trip.data.heroImage}
  ogType="article"
>
  {/* serializeJsonLd escapes '<' — safe for set:html even with CMS-authored titles. */}
  <script type="application/ld+json" set:html={jsonLd} is:inline />
  <StoryHero trip={trip} number={number} locale={locale} otherHref={other ? pathOf(other) : undefined} />

  <div class="mx-auto max-w-3xl px-5 pt-5 pb-10 sm:pt-6">
    <div class="story-reading">
      <Toc headings={headings} locale={locale} />
      {
        trip.data.keyFacts && (
          <KeyFacts facts={trip.data.keyFacts} country={trip.data.country} locale={locale} />
        )
      }
      <article id="story-body" class="prose prose-lg max-w-none prose-headings:font-extrabold prose-headings:text-navy prose-headings:break-words prose-p:break-words prose-li:break-words prose-a:font-semibold prose-a:text-brand-red prose-a:no-underline hover:prose-a:underline prose-blockquote:border-l-2 prose-blockquote:border-brand-red/60 prose-blockquote:bg-navy/[0.02] prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:italic prose-blockquote:text-navy prose-p:first-of-type:first-letter:float-left prose-p:first-of-type:first-letter:mr-3 prose-p:first-of-type:first-letter:text-5xl prose-p:first-of-type:first-letter:font-extrabold prose-p:first-of-type:first-letter:text-brand-red">
        <Content />
      </article>
      <GalleryIsland locale={locale} />
    </div>

    <StoryMiniMap trip={trip} locale={locale} />

    <div class="mt-12">
      <RouteDivider />
    </div>
    <StoryPagination older={older} newer={newer} locale={locale} />
  </div>
</Base>
