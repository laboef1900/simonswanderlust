---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FeaturedHero from '../FeaturedHero.astro';
import MapTeaser from '../MapTeaser.astro';
import RegionFilter from '../RegionFilter.astro';
import RouteDivider from '../RouteDivider.astro';
import StoryGrid from '../StoryGrid.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import { aboutPath } from '../../lib/paths';
import { byLocale, entryNumberOf } from '../../lib/trips';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// `byLocale` sorts newest-first (trips.ts: `b.data.date - a.data.date`), so
// `trips[0]` is the newest story and is the fallback cover.
const trips = byLocale(await getCollection('trips'), locale);
// @ai-note The cover is an EDITORIAL choice, not "whatever was published last":
// `featured` (content.config.ts) lets the author nominate the photograph the
// front door leads with. Uniqueness is deliberately not enforced anywhere —
// several posts may carry the flag and the newest of them wins, which is why
// this is a `find` over a newest-first list rather than a lookup that could
// fail. No flag at all = the newest story, i.e. the pre-#209 behaviour.
const flagged = trips.findIndex((t) => t.data.featured);
const coverIndex = flagged >= 0 ? flagged : 0;
const featured = trips[coverIndex];
---

<Base
  title={t('home.title')}
  description={t('site.tagline')}
  locale={locale}
  alternates={{ de: '/', en: '/en/' }}
  image={featured?.data.heroImage}
>
  {featured && <FeaturedHero trip={featured} number={entryNumberOf(featured, trips)} />}
  <MapTeaser locale={locale} />
  {
    /*
      @ai-warning The grid gets EVERY story, the hero included. It used to get
      `rest` — everything but the hero — under a heading reading "all travel
      stories" beside a chip counting `trips.length`, so the section claimed 9
      and held 8, and the one story it omitted was the newest: exactly the one
      the site most wants opened. (An older revision had the opposite bug, the
      grid repeating the hero as a second full-size tile; the fix for that was
      to exclude it, which bought this one.) The hero is a promotion of one of
      the grid's own entries rather than a twin of it, the way a lead story
      also appears in the index below it — and the count is true by
      construction, with nothing to keep in sync. What the grid DOES do about
      the repetition is hand the 4×2 lead tile to another story when the cover
      sits at index 0 (`coverIndex` → `demoteCover`), so the cover photograph
      is never painted at poster size twice on one screen.
    */
    trips.length > 0 && (
      <section id="stories" class="mx-auto max-w-6xl px-5 py-14">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <h2 class="text-3xl font-extrabold text-navy">{t('home.allStories')}</h2>
          <RegionFilter locale={locale} />
        </div>
        <div class="mt-6">
          <StoryGrid
            trips={trips}
            locale={locale}
            numberingPool={trips}
            coverIndex={coverIndex}
          />
        </div>
      </section>
    )
  }
  <RouteDivider />
  <section>
    <div class="mx-auto max-w-3xl px-5 py-14 text-center">
      <h2 class="text-3xl font-extrabold text-navy">{t('nav.about')}</h2>
      <p class="mx-auto mt-3 max-w-prose text-ink/80">{t('home.aboutTeaser.text')}</p>
      {/* The cameras are the credibility asset and only lived on /uber-mich/. */}
      <p class="mt-4 font-mono text-[11px] tracking-log text-navy/70 uppercase">{t('about.gear')}</p>
      <a
        href={aboutPath(locale)}
        class="group/about mt-4 inline-flex min-h-[44px] items-center gap-1.5 rounded px-2 text-sm font-semibold text-brand-red transition-[color] hover:text-brand-red-light"
      >
        <span>{t('home.aboutTeaser.cta')}</span>
        <svg aria-hidden="true" focusable="false" class="h-4 w-4 transition-transform duration-300 motion-safe:group-hover/about:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Base>
