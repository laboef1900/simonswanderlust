---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { useTranslations, type Locale, type UIKey } from '../../i18n/ui';
import { countLabel } from '../../i18n/count';
import { cardMetaLabel, coordsLabel } from '../../lib/format';
import { byLocale, liveRegions, pathOf, regionCounts, statsLine, tripStats } from '../../lib/trips';
import { tripPins } from '../../lib/map-data';
import { mapPath } from '../../lib/paths';
import { localeAlternates } from '../../lib/seo';
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const all = await getCollection('trips');
const trips = byLocale(all, locale);
const geojson = tripPins(all, locale);
const stats = statsLine(tripStats(trips), t);
const activeRegions = liveRegions(all, locale);
const counts = regionCounts(trips);
const indexedTrips = trips.map((trip, index) => ({ trip, index }));
---

<Base
  title={t('map.title')}
  description={t('map.intro')}
  locale={locale}
  alternates={localeAlternates(mapPath)}
>
  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-navy/15 pb-6">
      <div>
        {trips.length > 0 && <p class="font-mono text-xs font-semibold tracking-log text-brand-red">
          {stats}
        </p>}
        <h1 class="mt-1 text-3xl font-extrabold text-navy md:text-4xl">{t('map.title')}</h1>
        <p class="mt-1 text-ink/70">{t('map.intro')}</p>
      </div>
      {trips.length > 0 && (
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label={t('map.filterRegionLabel')}>
          <span class="mr-2 hidden font-mono text-xs font-semibold tracking-log text-navy/70 sm:inline">
            {trips.length} {countLabel(trips.length, t('map.pinCountOne'), t('map.pinCount'))}
          </span>
          {activeRegions.length > 1 && (
            <>
              <button
                type="button"
                data-map-region="all"
                aria-pressed="true"
                class="inline-flex min-h-[44px] cursor-pointer items-center gap-1.5 rounded border border-navy/55 bg-canvas px-3 py-1.5 font-mono text-xs font-semibold tracking-log text-navy transition-[color,background-color,border-color] hover:border-brand-red hover:text-brand-red aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white"
              >
                <span>{t('home.filter.all')}</span>
                <span class="tabular-nums opacity-80">{trips.length}</span>
              </button>
              {activeRegions.map((region) => (
                <button
                  type="button"
                  data-map-region={region}
                  aria-pressed="false"
                  class="inline-flex min-h-[44px] cursor-pointer items-center gap-1.5 rounded border border-navy/55 bg-canvas px-3 py-1.5 font-mono text-xs font-semibold tracking-log text-navy transition-[color,background-color,border-color] hover:border-brand-red hover:text-brand-red aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-white"
                >
                  <span>{t(`region.${region}` as UIKey)}</span>
                  <span class="tabular-nums opacity-80">{counts[region]}</span>
                </button>
              ))}
            </>
          )}
          <button
            type="button"
            data-map-reset
            class="inline-flex min-h-[44px] cursor-pointer items-center rounded border border-navy/55 bg-canvas px-3 py-1.5 font-mono text-xs font-semibold tracking-log text-navy transition-[color,border-color] hover:border-brand-red hover:text-brand-red"
          >
            {t('map.resetView')}
          </button>
        </div>
      )}
    </div>

    {trips.length === 0 ? (
      <div class="mt-8 py-8">
        <h2 class="text-lg font-bold text-navy">{t('map.emptyTitle')}</h2>
        <p class="mt-2 max-w-prose text-ink/70">{t('map.emptyBody')}</p>
      </div>
    ) : (
    <>
    <div class="relative mt-6 rounded-xl border border-navy/15 bg-canvas p-1.5 shadow-sm sm:p-2">
      <div
        id="map"
        class="h-[52vh] min-h-[360px] max-h-[640px] w-full overflow-hidden rounded-lg bg-navy/5 sm:h-[65vh]"
        data-geojson={JSON.stringify(geojson)}
        data-readstory={t('map.readStory')}
        data-pinlabel={t('map.pinLabel')}
        data-closepopup={t('map.closePopup')}
      ></div>
    </div>
    <nav class="mt-10" aria-label={t('map.fallbackHeading')}>
      <div class="flex items-baseline justify-between gap-4 border-b border-navy/15 pb-3">
        <h2 class="text-xl font-extrabold text-navy sm:text-2xl">{t('map.fallbackHeading')}</h2>
      </div>
      <div class="mt-6 space-y-8">
        {activeRegions.map((region) => {
          const entries = indexedTrips.filter(({ trip }) => trip.data.region === region);
          return (
            <section data-region-group={region} aria-labelledby={`map-region-${region}`}>
              <div class="flex items-baseline justify-between gap-3 border-b border-dashed border-navy/25 pb-2">
                <h3 id={`map-region-${region}`} class="font-mono text-sm font-semibold tracking-log text-navy">
                  {t(`region.${region}` as UIKey)}
                </h3>
                <span class="font-mono text-xs font-semibold tabular-nums text-brand-red">
                  {entries.length} {countLabel(entries.length, t('stats.trip'), t('stats.trips'))}
                </span>
              </div>
              <ol class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
                {entries.map(({ trip, index }) => (
                  <li
                    data-map-entry
                    data-pin-index={index}
                    data-region={region}
                    class="flex items-center gap-3 border-b border-navy/10 py-2.5 transition-[background-color] data-[active=true]:bg-navy/5"
                  >
                    <button
                      type="button"
                      data-map-focus={index}
                      aria-label={t('map.locateOnMap').replace('{title}', trip.data.title)}
                      class="inline-flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-navy/55 bg-canvas font-mono text-xs font-semibold tabular-nums text-navy transition-[color,background-color,border-color] hover:border-brand-red hover:bg-brand-red hover:text-white"
                    >
                      {String(index + 1).padStart(2, '0')}
                    </button>
                    <div class="min-w-0 flex-1">
                      <a
                        class="inline-flex min-h-[44px] items-center font-bold leading-snug text-navy underline-offset-4 hover:text-brand-red hover:underline"
                        href={pathOf(trip)}
                      >
                        {trip.data.title}
                      </a>
                      <p class="font-mono text-xs tracking-log text-navy/70">
                        {cardMetaLabel(trip.data.date, trip.data.country, locale)}
                      </p>
                      <p class="mt-0.5 font-mono text-[11px] tabular-nums text-navy/70">
                        {coordsLabel(trip.data.coordinates)}
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          );
        })}
      </div>
    </nav>
    </>
    )}
  </section>
</Base>

<script>
  const el = document.getElementById('map');
  if (el && el.dataset.geojson) {
    try {
      const { initFullMap } = await import('../../scripts/travel-map');
      initFullMap(
        el,
        JSON.parse(el.dataset.geojson) as import('../../lib/map-data').PinCollection,
        {
          readStory: el.dataset.readstory ?? '',
          pinLabel: el.dataset.pinlabel,
          closePopup: el.dataset.closepopup,
        },
      );
    } catch (err) {
      console.error('map init failed', err);
      el.replaceChildren();
      el.parentElement!.hidden = true;
    }
  }
</script>
