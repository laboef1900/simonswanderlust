---
import RemoteImage from './RemoteImage.astro';
import Stamp from './Stamp.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import { coordsLabel, dateLabel } from '../lib/format';
import { heroAltOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  locale: Locale;
  otherHref?: string;
}

const { trip, locale, otherHref } = Astro.props;
const t = useTranslations(locale);
const otherLocale = locale === 'de' ? 'en' : 'de';
const image = trip.data.heroImage;
const aspect = image.width / image.height;
// Cover paints whichever is wider: the viewport or the clamped height ×
// the photograph's actual aspect ratio. Mobile preserves the whole frame.
const sizes = `(max-width: 639px) 100vw, max(100vw, clamp(${240 * aspect}px, ${36 * aspect}vh, ${400 * aspect}px))`;
---

<header class="bg-canvas">
  <RemoteImage
    image={image}
    alt={heroAltOf(trip)}
    sizes={sizes}
    loading="eager"
    fetchpriority="high"
    class="block h-auto w-full object-cover sm:h-[36vh] sm:max-h-[400px] sm:min-h-[240px]"
  />

  {/* One grid, two placements. Below lg: field line and title span both
      columns, then the translation link beside the stamp — the old two-cell
      row. From lg the block widens to the site container and the stamp moves
      to the top-right corner above the story rail, as on the homepage hero;
      the text keeps the reading column's width (--container-story-column) so
      the title's left edge lines up with the article below it; the grid is
      the spread's own 60rem box (no gutters needed at lg — a 1024 viewport
      leaves 32px either side).
      The field line is the story's log entry: date · country, then the
      coordinates in the quiet weight — a measurement beside its label. No
      entry number here: it only ever said "sixth story published", which no
      reader navigates by; the homepage hero keeps it. */}
  <div class="mx-auto grid max-w-3xl grid-cols-[minmax(0,1fr)_auto] gap-x-4 px-5 pt-6 pb-4 sm:pt-8 lg:max-w-story-wide lg:grid-cols-[var(--container-story-column)_minmax(0,1fr)] lg:gap-x-12 lg:px-0">
    <p class="col-span-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-xs tracking-log text-navy/70 uppercase lg:col-span-1">
      <span class="break-words font-semibold">{dateLabel(trip.data.date, locale)} · {trip.data.country}</span>
      <span class="whitespace-nowrap">{coordsLabel(trip.data.coordinates)}</span>
    </p>
    <h1 class="col-span-2 mt-2 text-2xl leading-[1.12] font-extrabold text-balance break-words hyphens-auto text-navy sm:text-3xl sm:hyphens-none md:text-4xl lg:col-span-1">
      {trip.data.title}
    </h1>
    <div class="mt-4 min-w-0 self-center">
      {
        otherHref && (
          <a
            href={otherHref}
            lang={otherLocale}
            hreflang={otherLocale}
            class="inline-flex min-h-[44px] items-center gap-2 rounded-sm py-2 text-sm font-medium text-navy underline-offset-4 transition-[color] hover:text-brand-red hover:underline active:text-brand-red focus-visible:outline-2 focus-visible:outline-brand-red focus-visible:outline-offset-2"
          >
            <span>{t('story.otherLang')}</span>
            <svg aria-hidden="true" focusable="false" class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        )
      }
    </div>
    <div class="mt-4 shrink-0 self-center p-2 lg:col-start-2 lg:row-start-1 lg:row-span-3 lg:mt-0 lg:self-start lg:justify-self-end">
      <Stamp
        countryCode={trip.data.countryCode}
        country={trip.data.country}
        date={trip.data.date}
        region={trip.data.region}
        locale={locale}
      />
    </div>
  </div>
</header>
