---
import RemoteImage from './RemoteImage.astro';
import { dateLabel, entryLabel } from '../lib/format';
import { localeOf, pathOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Large card spanning 2 columns/rows in the grid. */
  featured?: boolean;
  /** Chronological entry number (from entryNumberOf); omits the N° prefix when absent. */
  number?: number;
}

const { trip, featured = false, number } = Astro.props;
const locale = localeOf(trip);
const label = [number !== undefined ? entryLabel(number) : null, `${dateLabel(trip.data.date, locale)} · ${trip.data.country}`]
  .filter(Boolean)
  .join(' — ');
---

<a
  href={pathOf(trip)}
  class:list={[
    'group relative block min-w-0 overflow-hidden rounded-md border border-navy/10 bg-navy shadow-sm transition-all duration-500 hover:border-brand-red/40 hover:shadow-xl motion-safe:hover:-translate-y-1 motion-safe:hover:rotate-[0.5deg] focus-visible:outline-2 focus-visible:outline-brand-red focus-visible:outline-offset-2',
    featured ? 'md:col-span-2 md:row-span-2' : '',
  ]}
>
  <RemoteImage
    image={trip.data.heroImage}
    alt=""
    sizes={featured ? '(min-width: 768px) 66vw, 100vw' : '(min-width: 768px) 33vw, 100vw'}
    class="h-full w-full object-cover opacity-90 transition-all duration-500 group-hover:opacity-100 motion-safe:group-hover:scale-[1.04]"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/30 to-transparent transition-opacity duration-300 group-hover:from-navy/85"></div>
  <div class="absolute right-0 bottom-0 left-0 p-5 text-white">
    <p class="font-mono text-[11px] font-semibold tracking-[0.2em] text-brand-red-light uppercase truncate">{label}</p>
    <h3 class:list={['mt-1 font-extrabold line-clamp-2 break-words transition-colors duration-300 group-hover:text-white', featured ? 'text-2xl' : 'text-lg']}>
      {trip.data.title}
    </h3>
  </div>
</a>
