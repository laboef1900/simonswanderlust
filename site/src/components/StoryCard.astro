---
import RemoteImage from './RemoteImage.astro';
import { dateLabel, entryLabel } from '../lib/format';
import { cardSizes, type StorySpan } from '../lib/story-grid-layout';
import { heroAltOf, localeOf, pathOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Span plan for this card, from `story-grid-layout.ts`. */
  span: StorySpan;
  /** Chronological entry number (from entryNumberOf); omits the N° prefix when absent. */
  number?: number;
  /** Grid-placement classes, computed by StoryGrid from the same span. */
  class?: string;
}

const { trip, span, number, class: placement } = Astro.props;
const locale = localeOf(trip);
const meta = `${dateLabel(trip.data.date, locale)} · ${trip.data.country}`;

// The lead tile is the only double-height one; the levelled tail tiles are
// wide but single-height. Three title sizes, so the grid has a hierarchy
// instead of one weight doing all the work — and they scale in the BASE
// regime too, not only at `lg`. Below 640px every card is full-width, so the
// span differences are invisible and a single `text-lg` rendered nine
// identical tiles at one type size inside a 4525px document; the lead tile's
// base `row-span-2` (StoryGrid) is what gives the largest step the room for a
// second clamped line. One source for the size: the <h3> below carries no
// size class of its own.
const lead = span.lgRows === 2 && span.lg >= 4;
const titleSize = lead
  ? 'text-xl lg:text-2xl'
  : span.lg >= 3
    ? 'text-lg lg:text-xl'
    : 'text-base lg:text-lg';

// Shared with FeaturedHero: a stored alt that only repeats the title is
// decorative here too (the <h3> below announces it), but a real description of
// the photograph is the only photographic content a screen-reader user can get
// from this index, so it is no longer thrown away.
const alt = heroAltOf(trip);
---

<a
  href={pathOf(trip)}
  class:list={[
    // Elevation is declared once, as shadow — the old card carried a 1px
    // border AND a wide soft shadow. The hover ring is a STATE, not resting
    // elevation, and it is what keeps a hover cue for a reduced-motion
    // visitor now that the resting opacity lift is gone: ring and shadow are
    // both box-shadow, so one entry covers them both.
    //
    // @ai-warning `translate` MUST stay in this list. Tailwind 4 compiles
    // `-translate-y-1` to the `translate` PROPERTY, not to `transform`
    // (`.motion-safe\:hover\:-translate-y-1:hover{--tw-translate-y:…;
    // translate:var(--tw-translate-x) var(--tw-translate-y)}` in the built
    // stylesheet), so a list of `transform,box-shadow` transitioned nothing
    // and the 4px lift landed in a single frame — measured final at 50ms —
    // beside a 500ms ring/shadow fade. `transform` is kept for the same
    // reason the image below is unaffected: the shorthand `transition-transform`
    // expands to `transform,translate,scale,rotate`, which is why the photo's
    // `scale-[1.04]` on the <RemoteImage> below never had this bug. Never
    // widen this to `transition-all` or `transition-colors` — both interpolate
    // `outline-color` and turn the focus ring into a 1.5px smudge (global.css).
    'group relative block min-w-0 overflow-hidden rounded-xl bg-navy shadow-sm transition-[transform,translate,box-shadow] duration-500 hover:shadow-xl hover:ring-2 hover:ring-brand-red motion-safe:hover:-translate-y-1',
    placement,
  ]}
>
  {/*
    @ai-warning No resting `opacity` on this image, and the scrim clears the
    top half. Both were the other way round: `opacity-90` over the navy card
    mixed 10% navy into every photograph, lifted to full only on
    `group-hover` — a state a touch device cannot enter, so the majority
    visitor never saw a single grid photograph at full fidelity on a site
    whose first principle is that photography leads. The hover reward is the
    scale, which fires everywhere a hover exists.
  */}
  <RemoteImage
    image={trip.data.heroImage}
    alt={alt}
    sizes={cardSizes(span)}
    class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.04]"
  />
  {/*
    Stops at 55% instead of running the full height: the text below carries
    its own opaque plate and needs no help from the scrim, so everything above
    the plate is photograph.
  */}
  <div class="absolute inset-0 bg-gradient-to-t from-navy/90 via-navy/25 via-55% to-transparent"></div>
  <div class="absolute right-0 bottom-0 left-0 p-4 text-white sm:p-5">
    {/*
      @ai-warning Opaque plate, for the same reason as FeaturedHero's: this line
      was `text-brand-red-light` straight over the photograph and measured
      1.90:1 to 5.01:1 depending only on which part of which frame sat behind
      the glyphs — the identity was legible on a jungle photo and invisible on
      sea-and-sky. On solid navy the accent is 4.8:1 and white is 14.6:1 on
      every card. Do not tint the plate with an alpha.
    */}
    {/*
      Wraps rather than truncates. `truncate` on the meta span cut the
      DESTINATION COUNTRY — the identity payload the card exists to deliver —
      on every card narrower than ~300px: 3 of 9 at a 320px viewport. The
      plate is `max-w-full` and wraps, so a long country takes a second line
      inside the plate instead of disappearing behind an ellipsis, and the
      card has the height to spare.
    */}
    <p
      class="inline-flex max-w-full flex-wrap items-center gap-x-2 rounded border border-white/15 bg-navy px-2 py-1 font-mono text-[11px] font-semibold tracking-log uppercase"
    >
      {number !== undefined && <span class="shrink-0 text-brand-red-light">{entryLabel(number)}</span>}
      <span class="min-w-0 break-words text-white">{meta}</span>
    </p>
    {/*
      `title` is the only signal that the clamp fired: a long title measured
      scrollHeight 140 against clientHeight 56 with nothing on screen saying
      so. The text is also in the <h3> itself, so this adds no name a screen
      reader has to hear twice.
    */}
    <h3 class:list={['mt-2 font-extrabold break-words line-clamp-2', titleSize]} title={trip.data.title}>
      {trip.data.title}
    </h3>
  </div>
</a>
