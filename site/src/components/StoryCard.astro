---
import RemoteImage from './RemoteImage.astro';
import { useTranslations } from '../i18n/ui';
import { cardMetaLabel, entryLabel } from '../lib/format';
import { cardSizes, type StorySpan } from '../lib/story-grid-layout';
import { heroAltOf, localeOf, pathOf, slugOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Span plan for this card, from `story-grid-layout.ts`. */
  span: StorySpan;
  /** Chronological entry number (from entryNumberOf); omits the N° prefix when absent. */
  number?: number;
  /** This story is also the page's cover (the hero above); marks the card as such. */
  cover?: boolean;
}

const { trip, span, number, cover = false } = Astro.props;
const locale = localeOf(trip);
const t = useTranslations(locale);
const meta = cardMetaLabel(trip.data.date, trip.data.country, trip.data.title, locale);

/*
  @ai-note Nine consecutive links each named "N°09 OKT 2024 · RUMÄNIEN
  <title>" is what a screen-reader user got from this index — entry number,
  month, year and country before learning what the story is, nine times in a
  row. `aria-labelledby` on the link scopes the name to the heading; the meta
  plate stays in the tree as content, just not as the link's name. The id is
  the slug, which is unique per document because a trip appears at most once
  in a grid (the home page's cover is the hero, which carries its own id).
  Same device as FeaturedHero's entry link.
*/
const titleId = `card-${slugOf(trip)}`;

/*
  Three title sizes from `sm` up, so the mosaic has a hierarchy instead of one
  weight doing all the work — but ONE size below it. Base is the regime where
  every card is full-width, so the span differences the tiers are derived from
  are invisible there: varying the type without varying the tile read as
  inconsistency rather than importance, and the smallest tier landed on
  `text-base`, i.e. the same 16px as body copy, for eight of nine cards.
*/
const lead = span.lgRows === 2 && span.lg >= 4;
const titleSize = lead
  ? 'text-xl lg:text-2xl'
  : span.lg >= 3
    ? 'text-xl sm:text-lg lg:text-xl'
    : 'text-xl sm:text-base lg:text-lg';

// Shared with FeaturedHero: a stored alt that only repeats the title is
// decorative here too (the <h3> below announces it), but a real description of
// the photograph is the only photographic content a screen-reader user can get
// from this index, so it is no longer thrown away.
const alt = heroAltOf(trip);
---

<a
  href={pathOf(trip)}
  aria-labelledby={titleId}
  class:list={[
    // Elevation is declared once, as shadow — the old card carried a 1px
    // border AND a wide soft shadow. The hover ring is a STATE, not resting
    // elevation, and it is what keeps a hover cue for a reduced-motion
    // visitor now that the resting opacity lift is gone: ring and shadow are
    // both box-shadow, so one entry covers them both.
    //
    // @ai-warning `active:` is not a duplicate of `hover:`. Tailwind 4 compiles
    // every `hover:` utility under `@media (hover: hover)`, and
    // `motion-safe:group-hover:` under that AND the reduced-motion query, so on
    // a touch device NONE of the feedback below can ever fire — the majority
    // visitor tapped a card and got the browser's default grey flash as the
    // only sign it registered. `active:` has no media gate.
    //
    // @ai-warning `translate` MUST stay in this list. Tailwind 4 compiles
    // `-translate-y-1` to the `translate` PROPERTY, not to `transform`
    // (`.motion-safe\:hover\:-translate-y-1:hover{--tw-translate-y:…;
    // translate:var(--tw-translate-x) var(--tw-translate-y)}` in the built
    // stylesheet), so a list of `transform,box-shadow` transitioned nothing
    // and the 4px lift landed in a single frame — measured final at 50ms —
    // beside a 500ms ring/shadow fade. `transform` is kept for the same
    // reason the image below is unaffected: the shorthand `transition-transform`
    // expands to `transform,translate,scale,rotate`, which is why the photo's
    // `scale-[1.04]` on the <RemoteImage> below never had this bug. Never
    // widen this to `transition-all` or `transition-colors` — both interpolate
    // `outline-color` and turn the focus ring into a 1.5px smudge (global.css).
    'group relative block h-full min-w-0 overflow-hidden rounded-xl bg-navy shadow-sm transition-[transform,translate,box-shadow] duration-500 hover:shadow-xl hover:ring-2 hover:ring-brand-red active:shadow-xl active:ring-2 active:ring-brand-red motion-safe:hover:-translate-y-1',
  ]}
>
  {/*
    @ai-warning No resting `opacity` on this image, and the scrim clears the
    top half. Both were the other way round: `opacity-90` over the navy card
    mixed 10% navy into every photograph, lifted to full only on
    `group-hover` — a state a touch device cannot enter, so the majority
    visitor never saw a single grid photograph at full fidelity on a site
    whose first principle is that photography leads. The hover reward is the
    scale, which fires everywhere a hover exists.
  */}
  <RemoteImage
    image={trip.data.heroImage}
    alt={alt}
    sizes={cardSizes(span)}
    class="h-full w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.04]"
  />
  {/*
    @ai-warning The type sits on an OPAQUE panel, feathered at the top, and
    that panel is the whole contrast mechanism on this card. It replaces two
    older ones, both of which failed in a measured way:

      · a card-height gradient, which is weakest exactly where the text is.
        The meta line read 1.90:1 to 5.01:1 depending only on which part of
        which frame sat behind the glyphs, and the title still measured
        4.38:1 on a pale sky patch after the mid stop was raised to /35.
      · a bordered `bg-navy` chip around the meta line alone. That fixed the
        contrast and created the problem this panel exists to solve: a filled,
        outlined, red-lettered box above the heading — the loudest object on a
        card whose one job is to get a title read.

    Do NOT try to serve the title from a card-height gradient again now that
    the meta sits BELOW it. Moving the title up puts its top around 46% of the
    card, where that gradient is near its weakest: re-derived against the same
    Rhodes sky pixel, white lands at 2.87:1 there. Holding the title would
    take roughly /62 alpha at the midpoint, i.e. veiling the whole lower half
    of every photograph — worse than a crisp panel and blurrier.

    The feather is a FIXED 24px with no type in it, not a percentage of the
    panel: a percentage scales with the title's line count, so the one number
    that guarantees contrast would change per card. The photograph is now
    completely unveiled above the panel, where it previously carried gradient
    over its full height.
  */}
  <div class="absolute inset-x-0 bottom-0">
    <div class="h-6 bg-gradient-to-t from-navy to-transparent"></div>
    <div class="bg-navy px-4 pt-0.5 pb-4 text-white sm:px-5 sm:pb-5">
      {/*
        `title` is the only signal that the clamp fired: a long title measured
        scrollHeight 140 against clientHeight 56 with nothing on screen saying
        so. The text is also in the <h3> itself, so this adds no name a screen
        reader has to hear twice.
      */}
      <h3
        id={titleId}
        class:list={['font-extrabold leading-tight break-words line-clamp-2', titleSize]}
        title={trip.data.title}
      >
        {trip.data.title}
      </h3>
      {/*
        @ai-note Below the heading, not above it, and demoted three ways at
        once. This line used to LEAD the card — entry number, month, year and
        country, at weight 600, in red on a bordered navy box — so the first
        thing the eye landed on was the catalogue data and the title came
        second. It is a footnote to the title and it is now ordered, weighted
        and coloured like one: no box, weight 400 for everything but the N°,
        and the cover marker as one red word instead of a filled red plate.

        Measured on the opaque panel: white 14.6:1, white/70 7.87:1,
        brand-red-light 4.741:1. The last one is why the panel may never be
        tinted with an alpha — the accent needs solid navy under it and misses
        AA at /98 over a bright sky.

        It wraps rather than truncates. `truncate` here once cut the
        destination country — the identity payload the card exists to deliver
        — on every card narrower than ~300px: 3 of 9 at a 320px viewport.
      */}
      <p class="mt-1.5 flex max-w-full flex-wrap items-center gap-x-2 gap-y-0.5 font-mono text-[11px] tracking-log uppercase">
        {number !== undefined && <span class="shrink-0 font-semibold text-white">{entryLabel(number)}</span>}
        <span class="min-w-0 break-words text-white/70">{meta}</span>
        {cover && <span class="shrink-0 text-brand-red-light">{t('stories.coverStory')}</span>}
      </p>
    </div>
  </div>
</a>
