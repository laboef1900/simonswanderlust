---
import RemoteImage from './RemoteImage.astro';
import { cardMetaLabel } from '../lib/format';
import { cardSizes, type StorySpan } from '../lib/story-grid-layout';
import { heroAltOf, localeOf, pathOf, slugOf, type Trip } from '../lib/trips';

interface Props {
  trip: Trip;
  /** Span plan for this card, from `story-grid-layout.ts`. */
  span: StorySpan;
  /** Already promoted in the homepage hero; keep its mobile index entry compact. */
  cover?: boolean;
}

const { trip, span, cover = false } = Astro.props;
const locale = localeOf(trip);
const meta = cardMetaLabel(trip.data.date, trip.data.country, trip.data.title, locale);

/*
  @ai-note Nine consecutive links each named "N°09 OKT 2024 · RUMÄNIEN
  <title>" is what a screen-reader user got from this index — catalogue data
  before learning what the story is, nine times in a row. `aria-labelledby` on
  the link scopes the name to the heading; the date line stays in the tree as
  content, just not as the link's name. The id is the slug, which is unique per
  document because a trip appears at most once in a grid (the home page's cover
  is the hero, which carries its own id). Same device as FeaturedHero's entry
  link.
*/
const titleId = `card-${slugOf(trip)}`;

// Desktop typography follows the mosaic; mobile captions show the full title.
// The cover is a compact index entry because its photograph already leads home.
const lead = span.lgRows === 2 && span.lg >= 4;
const titleSize = [
  cover ? 'text-base' : 'text-xl',
  lead
    ? 'sm:text-xl lg:text-2xl'
    : span.lg >= 3
      ? 'sm:text-lg lg:text-xl'
      : 'sm:text-base lg:text-lg',
];

// Shared with FeaturedHero: a stored alt that only repeats the title is
// decorative here too (the <h3> below announces it), but a real description of
// the photograph is the only photographic content a screen-reader user can get
// from this index, so it is no longer thrown away.
const alt = heroAltOf(trip);
---

<a
  href={pathOf(trip)}
  aria-labelledby={titleId}
  class:list={[
    // Elevation is declared once, as shadow — the old card carried a 1px
    // border AND a wide soft shadow. The hover ring is a STATE, not resting
    // elevation, and it is what keeps a hover cue for a reduced-motion
    // visitor now that the resting opacity lift is gone: ring and shadow are
    // both box-shadow, so one entry covers them both.
    //
    // @ai-warning `active:` is not a duplicate of `hover:`. Tailwind 4 compiles
    // every `hover:` utility under `@media (hover: hover)`, and
    // `motion-safe:group-hover:` under that AND the reduced-motion query, so on
    // a touch device NONE of the feedback below can ever fire — the majority
    // visitor tapped a card and got the browser's default grey flash as the
    // only sign it registered. `active:` has no media gate.
    //
    // @ai-warning `translate` MUST stay in this list. Tailwind 4 compiles
    // `-translate-y-1` to the `translate` PROPERTY, not to `transform`
    // (`.motion-safe\:hover\:-translate-y-1:hover{--tw-translate-y:…;
    // translate:var(--tw-translate-x) var(--tw-translate-y)}` in the built
    // stylesheet), so a list of `transform,box-shadow` transitioned nothing
    // and the 4px lift landed in a single frame — measured final at 50ms —
    // beside a 500ms ring/shadow fade. `transform` is kept for the same
    // reason the image below is unaffected: the shorthand `transition-transform`
    // expands to `transform,translate,scale,rotate`, which is why the photo's
    // `scale-[1.04]` on the <RemoteImage> below never had this bug. Never
    // widen this to `transition-all` or `transition-colors` — both interpolate
    // `outline-color` and turn the focus ring into a 1.5px smudge (global.css).
    'group relative grid h-full min-w-0 overflow-hidden rounded-xl bg-navy shadow-sm transition-[transform,translate,box-shadow] duration-500 hover:shadow-xl hover:ring-2 hover:ring-brand-red active:shadow-xl active:ring-2 active:ring-brand-red motion-safe:hover:-translate-y-1 sm:grid-cols-1 sm:grid-rows-[minmax(6rem,1fr)_auto]',
    cover ? 'min-h-28 grid-cols-[6rem_minmax(0,1fr)] sm:min-h-0' : 'grid-cols-1',
    lead && 'lg:block',
  ]}
>
  {/* Mobile photographs are uncropped; the cover alone uses an index thumbnail.
      Mosaic captions get their own row, with at least 6rem left for the photo.
      Only the double-height lead overlays its caption from lg. */}
  <div class:list={['overflow-hidden sm:h-full sm:min-h-0', cover ? 'relative sm:static' : '']}>
    <RemoteImage
      image={trip.data.heroImage}
      alt={alt}
      sizes={cardSizes(span)}
      class={[
        'block w-full object-cover transition-transform duration-500 sm:h-full motion-safe:sm:group-hover:scale-[1.04]',
        cover ? 'absolute inset-0 h-full sm:static' : 'h-auto',
      ].join(' ')}
    />
  </div>
  {/* The lg lead alone keeps the fixed ramp and navy/92 contrast floor.
      Smaller tiles use solid captions below an unobscured image region. */}
  <div class:list={['relative self-center sm:self-stretch', lead && 'lg:absolute lg:inset-x-0 lg:bottom-0']}>
    {lead && <div class="hidden h-18 bg-gradient-to-t from-navy/92 to-transparent lg:block"></div>}
    <div class:list={['bg-navy p-4 text-white', lead && 'lg:bg-navy/92 lg:px-5 lg:pt-0.5 lg:pb-5']}>
      {/* Mobile captions grow with the title; only fixed desktop tiles clamp. */}
      <h3
        id={titleId}
        class:list={['font-extrabold leading-tight break-words sm:line-clamp-2', ...titleSize]}
        title={trip.data.title}
      >
        {trip.data.title}
      </h3>
      {/*
        @ai-note What is left of the log register on a card: a date, and the
        country only when the title does not already name it. The entry number
        and the cover-story marker were both removed — nine `N°` labels down
        the index restated an order the grid already shows, and the marker was
        a second coloured object on the one card that least needed decorating.
        The `N°` still leads the hero's entry and every story page, which is
        where it carries information.

        It wraps rather than truncates. `truncate` here once cut the
        destination country — the identity payload the card exists to deliver
        — on every card narrower than ~300px: 3 of 9 at a 320px viewport.
      */}
      <p class="mt-1.5 max-w-full font-mono text-xs tracking-log break-words text-white/70 uppercase">
        {meta}
      </p>
    </div>
  </div>
</a>
