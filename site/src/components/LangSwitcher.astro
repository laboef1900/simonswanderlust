---
import { locales, useTranslations, type Locale } from '../i18n/ui';
import { homePath } from '../lib/paths';

interface Props {
  locale: Locale;
  alternates?: { de: string; en: string };
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const other: Locale = locale === 'de' ? 'en' : 'de';
const otherHref = alternates ? alternates[other] : homePath(other);

// @ai-note The switcher used to expose nothing to assistive tech: the current
// locale was a bare <span> with no `aria-current`, the outgoing link's whole
// accessible name was the string "EN", and the "|" between them was an
// un-hidden text node read out as "vertical line". The divider is now a 1px
// rule (drawn, not a glyph), the current locale carries `aria-current`, and the
// link names its destination in the reader's language.
const label: Record<Locale, string> = {
  de: t('nav.viewInGerman'),
  en: t('nav.viewInEnglish'),
};
// @ai-note The current locale was `text-navy` against an inactive `text-ink/60`
// — "active = slightly darker" is the cue most UIs use for enabled vs
// DISABLED, so the one state that mattered was carried by a contrast step
// nobody can name. It now carries a 2px brand underline, which is a different
// KIND of signal rather than more of the same one. Drawn as a border on a
// padded box, not `underline`, so it clears the glyph descenders and cannot be
// confused with the link styling beside it.
const target = 'inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded';
// @ai-warning `text-ink/60` here measured 4.33:1 on canvas — below AA at
// 12px/600, and on the single control a non-German visitor landing on `/`
// needs most. `/70` composites to 5.97:1, and the state signal is the active
// item's brand underline above, not this one being faded, so the alpha is
// free to rise. `tokens.test.ts` pins the composite.
const inactive = 'text-ink/70 transition-[color] hover:text-brand-red';
---

<div class="flex items-center text-xs font-semibold tracking-wide uppercase">
  {
    locales.map((code, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="h-3 w-px bg-navy/20"></span>}
        {code === locale ? (
          <span aria-current="true" class={`${target} border-b-2 border-brand-red text-navy`}>
            {code.toUpperCase()}
          </span>
        ) : (
          <a
            href={otherHref}
            hreflang={code}
            aria-label={label[code]}
            class={`${target} ${inactive}`}
          >
            {code.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</div>
