---
import StoryCard from './StoryCard.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import type { Trip } from '../lib/trips';
import { demoteCover, storyGridSpans } from '../lib/story-grid-layout';

interface Props {
  trips: Trip[];
  /** Locale of the surrounding page — drives the empty state (the grid itself can be empty). */
  locale: Locale;
  /**
   * Index in `trips` of the story the page also shows as its cover, if any.
   * Only affects which card gets the lead tile — see `demoteCover`.
   */
  coverIndex?: number;
}

const { trips, locale, coverIndex } = Astro.props;
const t = useTranslations(locale);
// The cover story stays in the grid (see HomePage.astro's @ai-warning) but must
// not ALSO hold the 4×2 lead tile, or the page paints the same photograph
// twice at poster size within one and a half viewports.
const spans = demoteCover(storyGridSpans(trips.length), coverIndex ?? -1);

// @ai-warning Do NOT put `content-visibility: auto` on the card grid. It implies
// `contain: paint`, which clips descendants to the padding box — this grid has no
// padding and the cards fill their tracks exactly, so the 2px focus ring every
// focusable gets from `:focus-visible` in global.css (offset 2px, so it paints
// OUTSIDE the card) would be sliced off on every edge card (WCAG 2.4.7). The
// grid is also the main content of the home/region pages, so skipping its
// layout buys little.
//
// @ai-note Six columns, never three. The span per card comes from
// `story-grid-layout.ts`, which levels the last row for ANY card count — a
// three-column grid cannot split a remainder of two, which is why the old
// `md:grid-cols-3` left a visible empty cell whenever the count was not a
// multiple of three. The class strings are written out literally here so
// Tailwind's source scanner sees every one of them; a computed
// `` `lg:col-span-${n}` `` would compile to nothing.
const SM_COL: Record<number, string> = {
  3: 'sm:col-span-3',
  6: 'sm:col-span-6',
};
const LG_COL: Record<number, string> = {
  2: 'lg:col-span-2',
  3: 'lg:col-span-3',
  4: 'lg:col-span-4',
  6: 'lg:col-span-6',
};

/*
  @ai-note Base-regime rhythm, independent of the `lg` mosaic on purpose.
  Below 640px every card is full-width, so the mosaic's span differences are
  invisible and the grid rendered as nine tiles of one identical height — a
  flat 2.5k-pixel run with no cadence, on the viewport most visitors arrive
  from. Every third card is double-height there, giving a short-short-tall
  measure that the eye can hold.

  The offset is 1, not 0, so the tall base tile lands on the same story the
  `lg` lead tile does after `demoteCover` swaps it forward — and so it never
  lands on the cover story at index 0, which the hero already showed at poster
  size. `sm:row-span-1` is REQUIRED, not tidying: the `sm` regime puts two
  cards per row and `cellsUsed()` accounts one row per card, so a tile spanning
  two rows there would punch exactly the hole `story-grid-layout` exists to
  prevent.
*/
const rowSpan = (baseTall: boolean, lgTall: boolean): string =>
  baseTall
    ? lgTall
      ? 'row-span-2 sm:row-span-1 lg:row-span-2'
      : 'row-span-2 sm:row-span-1'
    : lgTall
      ? 'lg:row-span-2'
      : '';
---

{
  trips.length > 0 ? (
    /*
      A list, because it is one: nine sibling links with no prose between them
      used to be a bare `<div>` of `<a>`s, so a screen-reader user got no
      "list of 9 items" and no item-n-of-n position while arrowing through the
      index. The `<li>` carries the grid placement; the card fills it.

      @ai-warning `role="list"` is REQUIRED here, not belt-and-braces. Tailwind
      Preflight sets `list-style: none` on every `ul`, and WebKit drops the
      implicit list semantics of a list styled that way — so the `<ul>` alone
      bought nothing in the one browser/screen-reader pair (Safari + VoiceOver)
      most likely to read this page. Verified against the rendered a11y tree,
      not assumed.
    */
    <ul role="list" class="grid list-none auto-rows-[280px] grid-cols-6 gap-4">
      {trips.map((trip, i) => {
        const span = spans[i]!;
        const baseTall = i % 3 === 1;
        return (
          <li
            class={[
              'min-w-0 col-span-6',
              SM_COL[span.sm],
              LG_COL[span.lg],
              rowSpan(baseTall, span.lgRows === 2),
            ]
              .filter(Boolean)
              .join(' ')}
          >
            <StoryCard trip={trip} span={span} baseTall={baseTall} />
          </li>
        );
      })}
    </ul>
  ) : (
    <div class="my-12 rounded-md border border-navy/10 bg-canvas p-8 text-center">
      <p class="font-mono text-xs font-semibold tracking-log text-navy/60 uppercase">
        {t('stories.emptyTitle')}
      </p>
      <p class="mt-1 text-sm text-ink/70">{t('stories.emptyBody')}</p>
    </div>
  )
}
