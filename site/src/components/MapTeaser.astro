---
import { getCollection } from 'astro:content';
import Contours from './Contours.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import { byLocale, statsLine, tripStats } from '../lib/trips';
import { mapPath } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const trips = byLocale(await getCollection('trips'), locale);
const stats = statsLine(tripStats(trips), t);
---

<section class="relative overflow-hidden bg-navy text-white">
  <Contours />
  {/* Decorative Cartographic Grid Overlay */}
  <svg
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full stroke-white/10 opacity-30"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id="map-grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#map-grid)" />
  </svg>
  <div class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-10">
    <div>
      <div class="flex items-center gap-2.5">
        <svg aria-hidden="true" focusable="false" class="h-5 w-5 text-brand-red-light shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <h2 class="text-2xl font-extrabold">{t('home.mapTeaser.title')}</h2>
      </div>
      <p class="mt-1 font-mono text-xs tracking-[0.15em] text-brand-red-light">{stats}</p>
    </div>
    <a
      href={mapPath(locale)}
      class="group inline-flex items-center gap-2 rounded border border-white/30 px-4 py-2 text-sm text-white/90 transition-all hover:border-brand-red hover:bg-brand-red/10 hover:text-white motion-safe:hover:-translate-y-0.5"
    >
      <span>{t('home.mapTeaser.cta')}</span>
      <svg aria-hidden="true" focusable="false" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>
