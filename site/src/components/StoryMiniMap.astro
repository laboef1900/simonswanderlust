---
import { useTranslations, type Locale } from '../i18n/ui';
import { mapPath } from '../lib/paths';
import { tripGeometry } from '../lib/map-data';
import type { Trip } from '../lib/trips';
import { publicTrackSummary } from '../lib/public-track';

interface Props { trip: Trip; locale: Locale }
const { trip, locale } = Astro.props;
const t = useTranslations(locale);
const geometry = tripGeometry(trip);
const routeRuns = geometry.track ? publicTrackSummary(geometry.track, locale) : [];
---
{/* A disclosure like Key Facts, so it can sit in the story rail (open there,
    collapsed on narrow screens ahead of the body). The map mounts lazily on
    intersection, which a closed <details> never reports — so opening it is
    what triggers the mount, and MapLibre's own ResizeObserver handles a later
    close/re-open. */}
<details class="mb-6 border-b border-navy/15 bg-canvas">
  <summary class="min-h-[44px] cursor-pointer py-3 text-sm font-semibold text-navy marker:text-brand-red hover:text-brand-red focus-visible:outline-2 focus-visible:outline-brand-red focus-visible:outline-offset-2">
    {t('map.miniLabel')}
  </summary>
  <div id="mini-map" class="mt-2 mb-5 h-64 w-full rounded-lg bg-navy/5" data-geometry={JSON.stringify(geometry)}>
    {!geometry.track && <a class="block p-4 text-brand-red hover:underline" href={mapPath(locale)}>{t('map.viewOnMap')}</a>}
  </div>
  {geometry.track && (
    <section class="mb-5 text-sm text-ink" aria-labelledby="public-route-heading">
      <h3 id="public-route-heading" class="font-semibold text-navy">{t('map.trackHeading')}</h3>
      {trip.data.route && <p class="mt-2 break-words">{trip.data.route}</p>}
      <ol class="mt-3 space-y-4">
        {routeRuns.map((run, index) => (
          <li>
            <p class="font-medium">{t('map.trackRun').replace('{number}', String(index + 1)).replace('{distance}', run.distance)}</p>
            <dl class="mt-1 text-xs leading-relaxed">
              <dt>{t('map.trackStart')}</dt>
              <dd class="font-mono tabular-nums">{run.start}</dd>
              <dt class="mt-1">{t('map.trackEnd')}</dt>
              <dd class="font-mono tabular-nums">{run.end}</dd>
            </dl>
          </li>
        ))}
      </ol>
      {geometry.stops.length > 0 && (
        <ul class="mt-4 list-inside list-disc space-y-1">
          {geometry.stops.map((stop) => <li class="break-words">{stop.properties.name}</li>)}
        </ul>
      )}
      <a class="mt-3 inline-flex min-h-[44px] items-center text-brand-red underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand-red focus-visible:outline-offset-2" href={mapPath(locale)}>{t('map.viewOnMap')}</a>
    </section>
  )}
</details>
<script>
  import { initMiniMap } from '../scripts/travel-map';
  import type { TripGeometry } from '../lib/map-data';

  const el = document.getElementById('mini-map');
  if (el && el.dataset.geometry) {
    let geometry: TripGeometry | null = null;
    try {
      geometry = JSON.parse(el.dataset.geometry) as TripGeometry;
    } catch (err) {
      console.error('mini-map: failed to parse geometry', err);
      // leave the fallback link in place
    }
    if (geometry !== null) {
      const fallbackHTML = el.innerHTML;
      const obs = new IntersectionObserver((entries, o) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            o.disconnect();
            el.innerHTML = '';  // clear the fallback link before mounting the map
            try {
              initMiniMap(el, geometry!);
            } catch (err) {
              console.error('mini-map: init failed', err);
              el.innerHTML = fallbackHTML;  // restore the fallback link
            }
          }
        }
      }, { rootMargin: '200px' });
      obs.observe(el);
    }
  }
</script>
